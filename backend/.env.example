# Copy this file to backend/.env and fill in what you need.
# Never commit .env (it's in .gitignore).

# Postgres connection string from Neon (Dashboard > Connection string).
# Leave it empty to use a local SQLite file instead (fine for quick testing).
DATABASE_URL=

# Google Places API (New) key. Leave empty to use the built-in sample Montreal places.
GOOGLE_PLACES_API_KEY=
# Optional: Gemini key from aistudio.google.com/apikey for AI ideas and icebreakers (works without it)
GEMINI_API_KEY=

# Demo helper: each real second counts as this many seconds when scoring.
# 1 = real time. 60 = one second counts as one minute (good for a 3-minute live demo).
POINTS_TIME_SCALE=1

# Game rules (defaults shown)
JOIN_RADIUS_M=100
HOME_RADIUS_M=100
DAILY_POINTS_CAP=300
HEX_RESOLUTION=9
TERRITORY_DECAY_PER_DAY=0.9
TIMEZONE=America/Montreal

# Sign in with Google (optional). Google Cloud Console > APIs & Services > Credentials > Create credentials >
# OAuth client ID > Web application. Under "Authorized JavaScript origins" add http://localhost:5173 and your
# deployed address (e.g. https://turfed.onrender.com). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Web Push notifications. Leave empty and the server makes a key pair once (saved in backend/vapid.json).
# Set these on a deployed server so the keys survive redeploys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Comma-separated list of front-end origins allowed to call the API.
# Not needed when FastAPI serves the built front end (same origin).
CORS_ORIGINS=*
